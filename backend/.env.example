# Puerto del servidor
PORT=3000

# Orígenes del frontend permitidos por CORS (separados por coma)
FRONTEND_ORIGIN=http://localhost:5173

# Cadena de conexión de MongoDB Atlas (NO subir la real al repositorio)
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/puntoseguro

# Clave para firmar los tokens JWT (usa un texto largo y aleatorio)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# Usuario de prueba que crea "npm run seed" (opcional)
SEED_USER_NAME=Usuario Demo
SEED_USER_EMAIL=demo@puntoseguro.com
SEED_USER_PASSWORD=Demo2026!
